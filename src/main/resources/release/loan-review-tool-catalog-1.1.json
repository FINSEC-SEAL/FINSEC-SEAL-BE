{
  "normalTools": [
    {
      "name": "CASE_CONTEXT_READ",
      "version": "1.1.0",
      "operation": "READ",
      "description": "Read current synthetic case context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          }
        },
        "required": [
          "caseId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "currentApplicantId": {
            "type": "string"
          },
          "workflowStage": {
            "type": "string"
          },
          "allowedDocumentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "caseId",
          "currentApplicantId",
          "workflowStage",
          "allowedDocumentIds"
        ],
        "additionalProperties": false
      },
      "trustLevel": "TRUSTED_INTERNAL",
      "riskLevel": "LOW",
      "dataClassifications": [
        "NORMAL"
      ],
      "sideEffectType": "NONE",
      "adapterKey": "case_context_read"
    },
    {
      "name": "DOCUMENT_READER",
      "version": "1.1.0",
      "operation": "READ",
      "description": "Read an allowed synthetic document; document content remains untrusted",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          }
        },
        "required": [
          "caseId",
          "documentId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "ownerCustomerId": {
            "type": "string"
          },
          "documentType": {
            "type": "string",
            "enum": [
              "INCOME_STATEMENT",
              "EMPLOYMENT_CERTIFICATE",
              "ID_COPY",
              "OTHER"
            ]
          },
          "content": {
            "type": "string",
            "x-trust-level": "UNTRUSTED"
          },
          "sourceTrustLevel": {
            "type": "string",
            "enum": [
              "UNTRUSTED_APPLICANT",
              "TRUSTED_INTERNAL"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "caseId",
          "documentId",
          "ownerCustomerId",
          "documentType",
          "content",
          "sourceTrustLevel",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "trustLevel": "TRUSTED_INTERNAL",
      "riskLevel": "MEDIUM",
      "dataClassifications": [
        "NORMAL",
        "PII"
      ],
      "sideEffectType": "NONE",
      "adapterKey": "document_reader"
    },
    {
      "name": "CUSTOMER_DATA_READ",
      "version": "1.1.0",
      "operation": "READ",
      "description": "Read explicitly requested synthetic customer fields",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "customerIds",
          "fields"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "const": 200
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "customerId": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "properties": {
                    "incomeBand": {
                      "type": "string"
                    },
                    "employmentStatus": {
                      "type": "string"
                    },
                    "accountNumber": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "customerId",
                "fields"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "rows"
        ],
        "additionalProperties": false
      },
      "trustLevel": "TRUSTED_INTERNAL",
      "riskLevel": "HIGH",
      "dataClassifications": [
        "NORMAL",
        "PII",
        "SENSITIVE_PII",
        "FINANCIAL",
        "CREDIT"
      ],
      "sideEffectType": "NONE",
      "adapterKey": "customer_data_read"
    },
    {
      "name": "LOAN_POLICY_SEARCH",
      "version": "1.1.0",
      "operation": "SEARCH",
      "description": "Search trusted synthetic loan policy",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "policies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "policyId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "productType": {
                  "type": "string"
                },
                "ruleCode": {
                  "type": "string"
                },
                "requirement": {
                  "type": "string"
                },
                "sourceTrustLevel": {
                  "type": "string",
                  "const": "TRUSTED_INTERNAL"
                }
              },
              "required": [
                "policyId",
                "version",
                "productType",
                "ruleCode",
                "requirement",
                "sourceTrustLevel"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "policies"
        ],
        "additionalProperties": false
      },
      "trustLevel": "TRUSTED_INTERNAL",
      "riskLevel": "LOW",
      "dataClassifications": [
        "NORMAL"
      ],
      "sideEffectType": "NONE",
      "adapterKey": "loan_policy_search"
    },
    {
      "name": "REVIEW_NOTE_WRITE",
      "version": "1.1.0",
      "operation": "CREATE",
      "description": "Write a document completeness review note",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "reviewResult": {
            "type": "object",
            "properties": {
              "reviewStatus": {
                "type": "string",
                "enum": [
                  "READY_FOR_HUMAN_REVIEW",
                  "NEEDS_MORE_DOCUMENTS"
                ]
              },
              "missingDocuments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rule",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "reviewStatus",
              "missingDocuments",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "caseId",
          "reviewResult"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "READY_FOR_HUMAN_REVIEW",
              "NEEDS_MORE_DOCUMENTS"
            ]
          },
          "missingDocuments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "rule",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "caseId",
          "reviewStatus",
          "missingDocuments",
          "evidence"
        ],
        "additionalProperties": false
      },
      "trustLevel": "TRUSTED_INTERNAL",
      "riskLevel": "MEDIUM",
      "dataClassifications": [
        "NORMAL"
      ],
      "sideEffectType": "INTERNAL_WRITE",
      "adapterKey": "review_note_write"
    }
  ],
  "serverToolCatalog": {
    "version": "loan-review-server/1.0",
    "tools": [
      {
        "name": "LOAN_DECISION_UPDATE",
        "version": "1.0.0",
        "operation": "UPDATE",
        "trustLevel": "TRUSTED_INTERNAL",
        "riskLevel": "CRITICAL",
        "sideEffectType": "HIGH_IMPACT_WRITE",
        "adapterKey": "loan_decision_update",
        "agentExecutable": false,
        "executionBoundary": "HUMAN_ONLY",
        "inputSchema": {
          "type": "object",
          "properties": {
            "caseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "decision": {
              "type": "string",
              "enum": [
                "APPROVED",
                "REJECTED"
              ]
            }
          },
          "required": [
            "caseId",
            "decision"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "const": 200
            },
            "caseId": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "enum": [
                "APPROVED",
                "REJECTED"
              ]
            },
            "rowVersion": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status",
            "caseId",
            "decision",
            "rowVersion"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
}
